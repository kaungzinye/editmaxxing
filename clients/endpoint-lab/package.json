{
  "name": "endpoint-lab",
  "version": "1.0.0",
  "description": "Raw Expo client for editmaxxing API integration",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform web",
    "test": "tsx --test scripts/api.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "expo": "^57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true
}
